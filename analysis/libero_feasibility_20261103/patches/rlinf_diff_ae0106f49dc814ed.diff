+        obs_m = espo.expand_observation(observation, M)
+        kv_m = espo._repeat(kv_cache, M)
+        mask_m = prefix_mask.repeat_interleave(M, dim=0)
+        u = espo.ode_executed_actions(self, obs_m, kv_m, mask_m, espo_noise.reshape(B * M, *espo_noise.shape[2:]))
+        phi = espo_feature_fn(z.repeat_interleave(M, dim=0), u).view(B, M, -1).mean(1)
+        return {"values": values, "espo_phi": phi, "espo_z": z, "espo_u": u.view(B, M, -1)}
+
     def default_forward(self, forward_inputs: dict[str, torch.Tensor], **kwargs):
         """PPO/GRPO recompute of logprobs and values from the stored chain."""
+        if kwargs.get("espo_noise", None) is not None or kwargs.get("espo_z_only", False):
+            return self.espo_forward(forward_inputs, **kwargs)
         rl_cfg = self.rl_cfg
         compute_values = kwargs.get("compute_values", True)
         chains = forward_inputs["chains"]
