+                success.sum(),
+                (1 - success).sum(),
+                (lengths * success).sum(),
+                (lengths * (1 - success)).sum(),
+                terminated.sum(),
+                (lengths * terminated).sum(),
+                (lengths * (1 - terminated)).sum(),
