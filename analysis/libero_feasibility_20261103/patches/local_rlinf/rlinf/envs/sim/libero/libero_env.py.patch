+    def _record_task_stats(self, terms, dones):
+        """accept_rollback (local addition 2026-11-05): append the first episode end of each env in this rollout
+        epoch (success termination = 1, truncation = 0) to <task_stats_dir>/env_<pid>.jsonl, before any auto-reset."""
+        import json as _json
+        import os as _os
+
+        rec = getattr(self, "_ts_recorded", None)
+        if rec is None or len(rec) != self.num_envs:
+            rec = self._ts_recorded = np.zeros(self.num_envs, dtype=bool)
+        new = np.asarray(dones, dtype=bool) & ~rec
+        if not new.any():
+            return
+        d = self.cfg.get("task_stats_dir")
+        _os.makedirs(d, exist_ok=True)
+        with open(_os.path.join(d, f"env_{_os.getpid()}.jsonl"), "a") as f:
+            for i in np.nonzero(new)[0]:
+                f.write(_json.dumps({"task": int(self.task_ids[i]), "s": int(bool(terms[i]))}) + "\n")
+        rec |= new
+
+    def _dump_eval_frames(self, obs, dones):
+        import imageio
+
+        every = int(self.cfg.get("dump_frames_every", 70))
+        imgs = obs.get("main_images") if isinstance(obs, dict) else None
+        if imgs is None:
+            return
+        imgs = imgs.detach().cpu().numpy() if torch.is_tensor(imgs) else np.asarray(imgs)
+        preds = None
+        if self.cfg.get("dump_goal_preds", False):  # goal_preds (local addition 2026-11-05): subgoal ground truth
+            due = [bool(dones[i]) or (int(self._elapsed_steps[i]) > 0 and int(self._elapsed_steps[i]) % every == 0)
+                   for i in range(self.num_envs)]
+            if any(due):
+                preds = self.env.goal_preds()
+        for i in range(self.num_envs):
+            t = int(self._elapsed_steps[i])
+            if not (bool(dones[i]) or (t > 0 and t % every == 0)):
+                continue
+            d = os.path.join(str(self.cfg.dump_frames_dir), f"task{int(self.task_ids[i])}_trial{int(self.trial_ids[i])}")
+            os.makedirs(d, exist_ok=True)
+            img = imgs[i]
+            if img.dtype != np.uint8:
+                img = np.clip(img, 0, 255).astype(np.uint8)
+            imageio.imwrite(os.path.join(d, f"step{t:04d}.png"), img)
+            if preds is not None:
+                import json as _json
+
+                with open(os.path.join(d, f"step{t:04d}.json"), "w") as f:
+                    _json.dump({"preds": preds[i], "done": bool(dones[i])}, f)
+
     def _handle_auto_reset(self, dones, _final_obs, infos):
